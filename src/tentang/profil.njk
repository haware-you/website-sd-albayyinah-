{% endcall %}

<section class="section section--mint">
  <div class="container split">
    <div>
      <p class="eyebrow">{{ c.visionTitle }}</p>
      <h2>{{ c.vision }}</h2>
    </div>
    <div>
      <p class="eyebrow">{{ c.missionTitle }}</p>
      <ol class="steps">{% for m in c.missions %}<li><p>{{ m }}</p></li>{% endfor %}</ol>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head"><h2>{{ c.valuesTitle }}</h2></div>
    {{ ui.featureCards(c.values) }}
  </div>
</section>

