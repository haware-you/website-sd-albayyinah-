{% import "components.njk" as ui %}
{{ ui.pageBanner(c.eyebrow, c.banner, t.photo[lang] + ": gedung sekolah") }}

{% call ui.split("", c.introTitle, t.photo[lang] + ": suasana sekolah") %}
