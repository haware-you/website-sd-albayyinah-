---
{% import "components.njk" as ui %}

<section class="hero">
  {{ ui.photo(t.photo[lang] + ": hero, siswa di halaman sekolah") }}
  <div class="container hero-inner">
    {{ ui.eyebrow(c.heroEyebrow) }}
    <h1>{{ c.heroTitle }}</h1>
    <p>{{ c.heroText }}</p>
    <div class="btn-row">
      <a class="btn btn--gold" href="{{ '/tentang/profil/' | langUrl(lang) }}">{{ t.learnMore[lang] }}</a>
    </div>
  </div>
</section>

{% call ui.split(c.whyEyebrow, c.whyTitle, t.photo[lang] + ": kegiatan belajar", false, t.learnMore[lang], '/tentang/profil/' | langUrl(lang)) %}
  <p>{{ c.whyText }}</p>
  <ul>{% for r in c.whyReasons %}<li>{{ r }}</li>{% endfor %}</ul>
{% endcall %}

<section class="section section--mint">
  <div class="container">
    <div class="section-head">
      <h2>{{ c.programTitle }}</h2>
      <p class="lead">{{ c.programText }}</p>
    </div>
    {{ ui.featureCards(c.programs) }}
  </div>
</section>

<section class="principal-band">
  <div class="container principal-inner">
    <div class="principal-card">
      <h2>{{ c.principalTitle }}</h2>
      <blockquote>{{ c.principalQuote }}</blockquote>
      <p><strong>{{ c.principalName }}</strong></p>
      <a class="btn btn--gold" href="{{ '/tentang/sambutan/' | langUrl(lang) }}">{{ t.learnMore[lang] }}</a>
    </div>
    {{ ui.photo(t.photo[lang] + ": kepala sekolah", "principal-photo") }}
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head"><h2>{{ c.statsTitle }}</h2></div>
    <div class="stats">
      {% for s in c.stats %}<div class="stat"><strong>{{ s.value }}</strong><span>{{ s.label }}</span></div>{% endfor %}
    </div>
  </div>
</section>

{{ ui.testimonials(c.testiTitle, c.testimonials) }}

<section class="section" data-tabs>
  <div class="container">
    <div class="section-head section-head--row">
      <h2>{{ c.newsTitle }}</h2>
      <div class="tabs" role="tablist">
        <button class="tab" role="tab" aria-selected="true" aria-controls="panel-news" id="tab-news">{{ c.newsTab }}</button>
        <button class="tab" role="tab" aria-selected="false" aria-controls="panel-gallery" id="tab-gallery">{{ c.galleryTab }}</button>
      </div>
    </div>
    <div id="panel-news" role="tabpanel" aria-labelledby="tab-news">
      <div class="news-grid">
        {% for n in c.news %}
        <article class="news-card">
          {{ ui.photo(t.photo[lang] + ": berita") }}
          <time>{{ n.date }}</time>
          <h3>{{ n.title }}</h3>
        </article>
        {% endfor %}
      </div>
    </div>
    <div id="panel-gallery" role="tabpanel" aria-labelledby="tab-gallery" hidden>
      <div class="news-grid">
        {% for i in range(0, 6) %}{{ ui.photo(t.photo[lang] + ": galeri " + (i + 1)) }}{% endfor %}
      </div>
    </div>
  </div>
</section>
