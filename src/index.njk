---
{% import "components.njk" as ui %}

<section class="hero">
  {{ ui.photo(t.photo[lang] + ": anak-anak di halaman sekolah, foto asli") }}
  <div class="container hero-inner">
    <h1>{{ c.heroTitle }}</h1>
    <p>{{ c.heroText }}</p>
    <p class="status">{{ c.heroStatus }}</p>
    <div class="btn-row">
      <a class="btn btn--gold" href="{{ '/ppdb/alur/' | langUrl(lang) }}">{{ c.heroCta }}</a>
      <a class="btn btn--outline btn--on-dark" href="{{ '/kontak/' | langUrl(lang) }}#kunjungan">{{ t.bookVisit[lang] }}</a>
    </div>
  </div>
</section>

<div class="container facts-wrap">
  {{ ui.facts(c.facts) }}
</div>

<section class="section">
  <div class="container split" style="align-items:start">
    <div>
      <div class="section-head"><h2>{{ c.dayTitle }}</h2><p>{{ c.dayIntro }}</p></div>
      {{ ui.day(c.day) }}
    </div>
    <div class="split-media">{{ ui.photo(t.photo[lang] + ": setoran hafalan pagi", "ph--tall") }}</div>
  </div>
</section>

<section class="section section--mint">
  <div class="container">
    <div class="section-head"><h2>{{ c.progTitle }}</h2><p>{{ c.progIntro }}</p></div>
    {{ ui.itemList(c.programs) }}
    <p style="margin-top:28px"><a class="text-link" href="{{ '/kurikulum/keislaman/' | langUrl(lang) }}">{{ c.dayLink }}</a></p>
  </div>
</section>

<section class="principal-band">
  <div class="container principal-inner">
    <div class="principal-card">
      <h2>{{ c.principalTitle }}</h2>
      <blockquote>{{ c.principalQuote }}</blockquote>
      <p><strong>{{ c.principalName }}</strong></p>
      <a class="text-link" href="{{ '/tentang/sambutan/' | langUrl(lang) }}">{{ c.principalLink }}</a>
    </div>
    {{ ui.photo(t.photo[lang] + ": kepala sekolah", "principal-photo") }}
  </div>
</section>

<section class="section section--mint">
  <div class="container">
    <div class="section-head"><h2>{{ c.quotesTitle }}</h2></div>
    {{ ui.quotes(c.quotes) }}
  </div>
</section>

<section class="section" data-tabs>
  <div class="container">
    <div class="section-head section-head--row">
      <h2>{{ c.newsTitle }}</h2>
      <div class="tabs" role="tablist">
        <button class="tab" role="tab" aria-selected="true" aria-controls="panel-news" id="tab-news">{{ c.newsTab }}</button>
        <button class="tab" role="tab" aria-selected="false" aria-controls="panel-gallery" id="tab-gallery">{{ c.galleryTab }}</button>
      </div>
    </div>
    <div id="panel-news" role="tabpanel" aria-labelledby="tab-news">
      <div class="news-grid">
        {% for n in c.news %}
        <article class="news-card">
          {{ ui.photo(t.photo[lang] + ": kegiatan") }}
          <time>{{ n.date }}</time>
          <h3>{{ n.title }}</h3>
        </article>
        {% endfor %}
      </div>
    </div>
    <div id="panel-gallery" role="tabpanel" aria-labelledby="tab-gallery" hidden>
      <div class="news-grid">
        {% for i in range(0, 6) %}{{ ui.photo(t.photo[lang] + " " + (i + 1)) }}{% endfor %}
      </div>
    </div>
  </div>
</section>
