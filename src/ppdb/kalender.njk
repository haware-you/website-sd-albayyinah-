---
slug: /ppdb/kalender/
copy:
  id:
    title: Kalender akademik
    crumb: Pendaftaran
    calTitle: Tahun ajaran [ISI]
    calHead: [Periode, Mulai, Selesai]
    cal:
      - ["Semester ganjil", "[ISI]", "[ISI]"]
      - ["Libur semester ganjil", "[ISI]", "[ISI]"]
      - ["Semester genap", "[ISI]", "[ISI]"]
      - ["Libur Ramadhan dan Idul Fitri", "[ISI]", "[ISI]"]
      - ["Libur kenaikan kelas", "[ISI]", "[ISI]"]
    hoursTitle: Jam sekolah
    hoursHead: [Kelas, Senin sampai Kamis, Jumat]
    hours:
      - ["Kelas 1 dan 2", "[ISI]", "[ISI]"]
      - ["Kelas 3 sampai 6", "[ISI]", "[ISI]"]
    ramadan: "[ISI] Jam sekolah selama Ramadhan."
  en:
    title: Academic calendar
    crumb: Admissions
    calTitle: School year [FILL]
    calHead: [Period, Starts, Ends]
    cal:
      - ["First semester", "[FILL]", "[FILL]"]
      - ["First semester break", "[FILL]", "[FILL]"]
      - ["Second semester", "[FILL]", "[FILL]"]
      - ["Ramadan and Eid al-Fitr break", "[FILL]", "[FILL]"]
      - ["End-of-year break", "[FILL]", "[FILL]"]
    hoursTitle: School hours
    hoursHead: [Grade, Monday to Thursday, Friday]
    hours:
      - ["Grades 1 and 2", "[FILL]", "[FILL]"]
      - ["Grades 3 to 6", "[FILL]", "[FILL]"]
    ramadan: "[FILL] School hours during Ramadan."
---
{% import "components.njk" as ui %}
{{ ui.pageBanner(c.crumb, c.title, t.photo[lang] + ": kegiatan sekolah", t.home[lang], '/' | langUrl(lang)) }}

<section class="section">
  <div class="container split" style="align-items:start">
    <div>
      <h2>{{ c.calTitle }}</h2>
      <div class="table-wrap">
        <table class="info-table">
          <thead><tr>{% for h in c.calHead %}<th>{{ h }}</th>{% endfor %}</tr></thead>
          <tbody>{% for r in c.cal %}<tr><td><strong>{{ r[0] }}</strong></td><td>{{ r[1] }}</td><td>{{ r[2] }}</td></tr>{% endfor %}</tbody>
        </table>
      </div>
    </div>
    <div>
      <h2>{{ c.hoursTitle }}</h2>
      <div class="table-wrap">
        <table class="info-table">
          <thead><tr>{% for h in c.hoursHead %}<th>{{ h }}</th>{% endfor %}</tr></thead>
          <tbody>{% for r in c.hours %}<tr><td><strong>{{ r[0] }}</strong></td><td>{{ r[1] }}</td><td>{{ r[2] }}</td></tr>{% endfor %}</tbody>
        </table>
      </div>
      <p style="margin-top:16px;color:var(--c-muted)">{{ c.ramadan }}</p>
    </div>
  </div>
</section>

{% include "partials/prevnext.njk" %}
