    <h2 style="margin-top:48px">{{ c.askTitle }}</h2>
    <a class="btn btn--gold" href="{{ '/kontak/' | langUrl(lang) }}#tanya">{{ t.chatWa[lang] }}</a>
  </div>
</section>

