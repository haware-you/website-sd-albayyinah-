---
slug: /ppdb/syarat/
copy:
  id:
    title: Syarat dokumen
    crumb: Pendaftaran
    intro: "Siapkan fotokopi dokumen berikut. Bawa juga aslinya saat menyerahkan, untuk dicocokkan. [ISI] Sesuaikan dengan syarat sekolah."
    docs:
      - "Akta kelahiran anak"
      - "Kartu Keluarga"
      - "KTP ayah dan ibu"
      - "Pas foto anak, [ISI ukuran], [ISI] lembar"
      - "Ijazah atau surat keterangan TK, jika ada"
    transferTitle: Untuk siswa pindahan
    transfer:
      - "Rapor terakhir"
      - "Surat pindah dari sekolah asal"
      - "[ISI] Dokumen lain"
    ageNote: "[ISI] Usia minimal kelas 1 per [ISI tanggal]. Cek aturan usia SD terbaru dari Kemendikdasmen."
  en:
    title: Documents needed
    crumb: Admissions
    intro: "Prepare copies of the documents below and bring the originals so we can check them. [FILL] Adjust to the school's requirements."
    docs:
      - "Child's birth certificate"
      - "Family Card (Kartu Keluarga)"
      - "Both parents' ID cards (KTP)"
      - "Child's passport photo, [FILL size], [FILL] copies"
      - "Kindergarten certificate or letter, if any"
    transferTitle: For transfer students
    transfer:
      - "Latest report card"
      - "Transfer letter from the previous school"
      - "[FILL] Other documents"
    ageNote: "[FILL] Minimum age for grade 1 as of [FILL date]. Check the Ministry's latest primary school age rule."
---
{% import "components.njk" as ui %}
{{ ui.pageBanner(c.crumb, c.title, t.photo[lang] + ": berkas pendaftaran", t.home[lang], '/' | langUrl(lang)) }}

<section class="section">
  <div class="container split" style="align-items:start">
    <div class="split-body">
      <p class="lead">{{ c.intro }}</p>
      <ul>{% for d in c.docs %}<li>{{ d }}</li>{% endfor %}</ul>
      <p class="note">{{ c.ageNote }}</p>
    </div>
    <div class="split-body">
      <h2>{{ c.transferTitle }}</h2>
      <ul>{% for d in c.transfer %}<li>{{ d }}</li>{% endfor %}</ul>
    </div>
  </div>
</section>

