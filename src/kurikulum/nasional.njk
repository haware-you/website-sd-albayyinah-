---
{% import "components.njk" as ui %}
{{ ui.pageBanner(c.eyebrow, c.banner, t.photo[lang] + ": kelas") }}

{% call ui.split("", c.introTitle, t.photo[lang] + ": siswa kelas 1") %}
  <p>{{ c.intro }}</p>
{% endcall %}

<section class="section section--mint">
  <div class="container">
    <div class="section-head"><h2>{{ c.phaseTitle }}</h2></div>
    <div class="table-wrap">
      <table class="info-table">
        <thead><tr>{% for h in c.tableHead %}<th>{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>{% for p in c.phases %}<tr><td><strong>{{ p.phase }}</strong></td><td>{{ p.grades }}</td><td>{{ p.focus }}</td></tr>{% endfor %}</tbody>
      </table>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head"><h2>{{ c.subjectTitle }}</h2></div>
    <div class="subject-grid">
      {% for s in c.subjects %}<div class="subject"><span class="feature-icon" aria-hidden="true">{{ s.icon }}</span>{{ s.title }}</div>{% endfor %}
    </div>
  </div>
</section>

