---
{% import "components.njk" as ui %}
{{ ui.pageBanner(c.crumb, c.title, t.photo[lang] + ": kelas", t.home[lang], '/' | langUrl(lang)) }}

<section class="section">
  <div class="container">
    <div class="section-head"><p class="lead">{{ c.intro }}</p></div>
    <div class="split" style="align-items:start">
      <div>
        <h2>{{ c.phaseTitle }}</h2>
        <div class="table-wrap">
          <table class="info-table">
            <thead><tr>{% for h in c.tableHead %}<th>{{ h }}</th>{% endfor %}</tr></thead>
            <tbody>{% for p in c.phases %}<tr><td><strong>{{ p.phase }}</strong></td><td>{{ p.grades }}</td><td>{{ p.focus }}</td></tr>{% endfor %}</tbody>
          </table>
        </div>
      </div>
      <div>
        <h2>{{ c.subjectTitle }}</h2>
        <div class="table-wrap">
          <table class="info-table">
            <thead><tr>{% for h in c.subjectHead %}<th>{{ h }}</th>{% endfor %}</tr></thead>
            <tbody>{% for s in c.subjects %}<tr><td>{{ s[0] }}</td><td>{{ s[1] }}</td></tr>{% endfor %}</tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>

{% include "partials/prevnext.njk" %}
