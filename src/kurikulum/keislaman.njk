{% import "components.njk" as ui %}
{{ ui.pageBanner(c.crumb, c.title, t.photo[lang] + ": halaqah tahfidz", t.home[lang], '/' | langUrl(lang)) }}

<section class="section">
  <div class="container">
    <div class="section-head"><p class="lead">{{ c.intro }}</p></div>
    {{ ui.itemList(c.programs) }}
  </div>
</section>

<section class="section section--mint">
  <div class="container">
    <div class="section-head"><h2>{{ c.targetTitle }}</h2><p>{{ c.targetNote }}</p></div>
    <div class="table-wrap">
      <table class="info-table">
        <thead><tr>{% for h in c.targetHead %}<th>{{ h }}</th>{% endfor %}</tr></thead>
        <tbody>{% for r in c.targets %}<tr><td><strong>{{ r[0] }}</strong></td><td>{{ r[1] }}</td><td>{{ r[2] }}</td></tr>{% endfor %}</tbody>
      </table>
    </div>
  </div>
</section>

