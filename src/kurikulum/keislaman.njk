{% import "components.njk" as ui %}
{{ ui.pageBanner(c.eyebrow, c.banner, t.photo[lang] + ": siswa mengaji") }}

{% call ui.split("", c.introTitle, t.photo[lang] + ": halaqah tahfidz") %}
  <p>{{ c.intro }}</p>
{% endcall %}

<section class="section section--mint">
  <div class="container">{{ ui.featureCards(c.programs) }}</div>
</section>

<section class="section">
  <div class="container split" style="align-items:start">
    <div>
      <h2>{{ c.targetTitle }}</h2>
      <div class="table-wrap">
        <table class="info-table">
          <thead><tr>{% for h in c.targetHead %}<th>{{ h }}</th>{% endfor %}</tr></thead>
          <tbody>{% for r in c.targets %}<tr><td>{{ r[0] }}</td><td>{{ r[1] }}</td></tr>{% endfor %}</tbody>
        </table>
      </div>
    </div>
    <div>
      <h2>{{ c.routineTitle }}</h2>
      <ol class="steps">{% for s in c.routine %}<li><h3>{{ s.title }}</h3><p>{{ s.text }}</p></li>{% endfor %}</ol>
    </div>
  </div>
</section>

